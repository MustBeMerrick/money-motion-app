generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  CREDIT
}

model Account {
  id           String      @id @default(cuid())
  name         String
  type         AccountType
  // signed balance the account held before its first logged Transaction
  // (assets positive, credit-card debt negative) — an anchor, not the current
  // balance. The live balance shown throughout the app is this plus the net
  // of every Transaction since (see lib/data.ts's getAccountsWithBalances),
  // so fixing a drifted balance means correcting this value, not the display.
  // @map keeps the underlying column name so renaming this needed no migration.
  startingBalanceCents Int  @default(0) @map("balanceCents")
  color        String?
  // optional second stop: when set, the card gradient blends color -> color2
  // before fading into the surface, instead of a single-hue fade
  color2       String?
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transactions       Transaction[] @relation("TransactionAccount")
  transactionsInto   Transaction[] @relation("TransactionToAccount")
  defaultForPayees   Payee[]
}

model MonthPlan {
  id     String @id @default(cuid())
  // "YYYY-MM"
  month  String @unique
  // paid semi-monthly: mid-month (the 15th, or prior weekday) and
  // end-of-month (last day, or prior weekday) — see semiMonthlyPayDates()
  salaryMidCents    Int     @default(0)
  salaryMidReceived Boolean @default(false)
  salaryEndCents    Int     @default(0)
  salaryEndReceived Boolean @default(false)
  savingsCents      Int     @default(0)
}

enum BillFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model Bill {
  id             String        @id @default(cuid())
  name           String
  amountCents    Int
  shared         Boolean       @default(false)
  // expected payback from the other party; only meaningful when shared
  reimburseCents Int           @default(0)
  frequency      BillFrequency @default(MONTHLY)
  // day of month, 1-31. MONTHLY and YEARLY only; ignored for WEEKLY
  dueDay         Int
  // 1-12, YEARLY bills only
  dueMonth       Int?
  // 0 = Sunday .. 6 = Saturday, WEEKLY bills only
  dueWeekday     Int?
  color          String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  occurrences    BillOccurrence[]
}

// One row per actual charge. A monthly bill has one per month, a weekly bill
// has four or five — which is why status is keyed by date rather than month.
model BillOccurrence {
  id     String  @id @default(cuid())
  bill   Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId String
  // the date this specific charge falls on, "YYYY-MM-DD"
  date   String
  // charge has landed on the card (so it's already inside the CC balance)
  hit    Boolean @default(false)
  // reimbursed by the other party (shared bills only)
  paid   Boolean @default(false)

  @@unique([billId, date])
  @@index([date])
}

// Persists until manually removed (not tied to a month) — e.g. an expected
// reimbursement or one-off payment you're waiting on.
model ExtraIncome {
  id            String   @id @default(cuid())
  source        String
  expectedCents Int
  receivedCents Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model PiggyBucket {
  id             String    @id @default(cuid())
  name           String
  // "YYYY-MM-DD"; day the current principal started amortizing
  startDate      String
  // signed effective start value (the sheet's "Offset"):
  //   positive = money granted back to the budget, released down to target
  //   negative = money siphoned aside from the budget
  principalCents Int
  // signed daily change applied to the value
  ratePerDayCents Int
  // value at which the bucket completes; null = perpetual
  targetCents    Int?
  // the original full amount (the sheet's "Start"), for progress display
  originalCents  Int?
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

// Fixed, not user-editable — kept in sync by hand with lib/core/categories.ts,
// which carries the display labels, emoji, and parent/child grouping (Auto,
// Tax, and Utilities each have subcategories; the parent stays selectable on
// its own too).
enum CategoryKey {
  AUTO
  AUTO_GAS
  AUTO_REGISTRATION
  AUTO_SERVICE
  BANK_CHARGE
  BEAUTY
  CHARITY
  CHILDCARE
  CLOTHING
  COFFEE
  CREDIT_CARD_PAYMENT
  DESSERT
  DEVICES
  DRINKS
  EATING_OUT
  EDUCATION
  ENTERTAINMENT
  GAMBLING
  GIFTS
  GROCERIES
  HEALTH_FITNESS
  HOME_REPAIR
  HOUSEHOLD
  INSURANCE
  INTEREST
  LOAN
  MEDICAL
  MISC
  MORTGAGE
  OTHERS
  PETS
  RENT
  SAVINGS
  TAX
  TAX_FED
  TAX_STATE
  TRANSPORT
  TRAVEL
  TV
  UTILITIES
  UTILITIES_TRASH_RECYCLING
  UTILITIES_GAS_ELECTRIC
  UTILITIES_INTERNET
  UTILITIES_PHONE
  UTILITIES_WATER
  WEDDING
  INCOME_ASCAP
  INCOME_BONUS
  INCOME_GAMBLING
  INCOME_GIFT
  INCOME_OPTIONS
  INCOME_OTHERS
  INCOME_REFUND
  INCOME_SALARY
  INCOME_TAX_REFUND
}

// A payee "learns" which account (and category) it's usually charged to —
// the fix for the spreadsheet's manual habit of always defaulting to the same
// card. Picking a payee prefills these; saving against a different one
// overwrites it for next time.
model Payee {
  id               String       @id @default(cuid())
  name             String       @unique
  category         CategoryKey?
  defaultAccount   Account?     @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  defaultAccountId String?
  createdAt        DateTime     @default(now())

  transactions Transaction[]
}

// One row per logged charge/deposit/transfer. Saving one moves real money:
// EXPENSE and INCOME move `account`'s balance by -amount / +amount; TRANSFER
// moves it out of `account` and into `toAccount`.
model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  // "YYYY-MM-DD"
  date        String
  // always positive; sign of the balance effect comes from `type`
  amountCents Int
  // EXPENSE only: someone paid you back (e.g. a spouse covering half a
  // bill). Money-wise it's incoming, so the balance effect flips to +amount
  // same as INCOME -- but it stays type EXPENSE and nets against that day's
  // expense total instead of adding to income, matching how Marc logged
  // these as negative expenses in his old tracker.
  reimbursement Boolean       @default(false)
  account     Account         @relation("TransactionAccount", fields: [accountId], references: [id])
  accountId   String
  // TRANSFER only
  toAccount   Account?        @relation("TransactionToAccount", fields: [toAccountId], references: [id])
  toAccountId String?
  payee       Payee?          @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  payeeId     String?
  category    CategoryKey?
  memo        String?
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([accountId])
}
