# Server runtime env — copied to ~/apps/money-motion-app/env by `deploy.sh init`.
# Fill in real values on the server; this template holds no secrets.
# DATABASE_URL is intentionally absent: it is pinned in deploy/compose.yml.

APP_URL=https://moneymotion.mustbemerrick.com

# Auth. Generate both with `npm run auth:hash` on the Mac and paste the
# output here. Without them every deployed request bounces to /login and
# cannot get past it. `next dev` ignores the gate entirely.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
